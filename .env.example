# ===================================================
# ArecaHarvest Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ===================================================

# --- Database ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=arecaharvest
MYSQL_USER=arecauser
MYSQL_PASSWORD=arecapassword

# --- JWT ---
# Must be at least 64 characters for HS512
JWT_SECRET=changeme_use_a_very_strong_random_secret_key_at_least_64_characters
JWT_EXPIRATION_MS=86400000

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
